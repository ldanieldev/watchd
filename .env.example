NUXT_APP_SECRET=
APP_NAME=
PORT=
# --- Postgres -----------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
INNGEST_SCHEMA=
DATABASE_URL=
# --- Redis --------------------------------------------------------------
REDIS_URL=
# --- Inngest ------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# --- Sentry (hosted, sentry.io) -----------------------------------------
# Leave empty to disable error reporting. Get this from your sentry.io
# project: Settings -> Projects -> <project> -> Client Keys (DSN).
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# --- Admin UIs ---------------------------------------------------------
# redisinsight (Redis browser)        -> http://localhost:5540
REDISINSIGHT_PORT=
# --- Search and cache --------------------------------------------------
NUXT_MEILI_HOST=
NUXT_MEILI_API_KEY=
NUXT_REDIS_URL=
# --- Inngest dev (never in production) ---------------------------------
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_SERVE_ORIGIN=http://host.docker.internal:3000
# --- Metrics and logging ------------------------------------------------
ENABLE_OPENTELEMETRY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
LOG_LEVEL=
MIMIR_PUSH_URL=
LOKI_PUSH_URL=
OTEL_SERVICE_NAME=
NUXT_TMDB_API_KEY=
# --- Optional ---------------------------------------------------------
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=
SENTRY_UPLOAD_SOURCEMAPS=
SENTRY_LOG_LEVEL=
LOG_FILE=
